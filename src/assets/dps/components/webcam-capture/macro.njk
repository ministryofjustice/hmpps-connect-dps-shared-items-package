  <svg width="69" height="47" viewBox="0 0 69 47" xmlns="http://www.w3.org/2000/svg">
    <path fill="currentColor" d="M41.9.016a5.87 5.87 0 0 1 4.941 3.5l1.106 2.529H58.62a5.85 5.85 0 0 1 4.231 1.806l2.877-1.66a1.956 1.956 0 1 1 1.955 3.388l-3.217 1.856q.02.236.022.477v28.039l-.03.601a5.87 5.87 0 0 1-5.236 5.236l-.602.03H10.707a5.84 5.84 0 0 1-3.641-1.268l-3.791 2.188A1.956 1.956 0 0 1 1.32 43.35l3.663-2.114a6 6 0 0 1-.112-.684l-.03-.601V11.912a5.87 5.87 0 0 1 5.866-5.867h10.672l1.105-2.528A5.87 5.87 0 0 1 27.862 0h13.604Zm5.779 21.103c.44 1.316.68 2.724.68 4.188l-.019.677c-.353 6.966-6.112 12.505-13.165 12.506l-.68-.018a13.15 13.15 0 0 1-9.2-4.44L11.65 41.908H58.62l.2-.01a1.96 1.96 0 0 0 1.747-1.747l.01-.2V13.68ZM27.862 3.911a1.96 1.96 0 0 0-1.793 1.174l-1.616 3.7a1.96 1.96 0 0 1-1.793 1.171H10.707c-1.08 0-1.955.876-1.955 1.956v27.15l14.41-8.314a13.1 13.1 0 0 1-1.154-4.764l-.018-.677c0-7.281 5.904-13.186 13.185-13.186l.678.018a13.17 13.17 0 0 1 10.043 5.493l13.2-7.615a2 2 0 0 0-.276-.05l-.2-.01H46.665c-.777 0-1.481-.46-1.793-1.172l-1.616-3.7a1.96 1.96 0 0 0-1.503-1.153l-.287-.02zm.922 28.109a9.24 9.24 0 0 0 6.39 2.559 9.273 9.273 0 0 0 9.015-11.446zm6.39-15.988c-5.12 0-9.273 4.154-9.273 9.275 0 1.228.241 2.4.675 3.472l15.906-9.177a9.25 9.25 0 0 0-7.307-3.57"/>
