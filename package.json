{
  "name": "@ministryofjustice/hmpps-connect-dps-shared-items",
  "version": "5.2.1",
  "description": "A package to share Connect DPS functionality across applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "*.md",
    "dist/**/*"
  ],
  "engines": {
    "node": "22 || 24 || 26"
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --bundleConfigAsCjs",
    "clean": "rm -rf ./dist/",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc && tsc -p src/assets",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --max-warnings 0 --fix",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "prepare": "hmpps-precommit-hooks-prepare",
    "precommit:secrets": "gitleaks git --pre-commit --redact --staged --verbose --config .gitleaks/config.toml",
    "precommit:lint": "lint-staged",
    "precommit:verify": "npm run typecheck && npm test",
    "setup": "npm ci && hmpps-npm-script-run-allowlist",
    "start": "node --experimental-strip-types preview/server.mts"
  },
  "lint-staged": {
    "*.{ts,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "author": "hmpps-developers",
  "homepage": "https://github.com/ministryofjustice/hmpps-connect-dps-shared-items-package#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ministryofjustice/hmpps-connect-dps-shared-items-package.git"
  },
  "bugs": {
    "url": "https://github.com/ministryofjustice/hmpps-connect-dps-shared-items-package/issues"
  },
  "devDependencies": {
    "@ministryofjustice/eslint-config-hmpps": "2.0.0-alpha.2",
    "@ministryofjustice/frontend-types": "2.0.2",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.6",
    "@ministryofjustice/hmpps-precommit-hooks": "3.0.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "24.0.5",
    "@types/jest": "^30.0.0",
    "@types/nunjucks": "3.2.6",
    "@types/superagent": "^8.1.11",
    "govuk-frontend": "6.4.0",
    "jest": "^30.4.2",
    "jest-html-reporter": "^4.4.0",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.2.0",
    "nock": "14.0.17",
    "nunjucks": "3.2.4",
    "rollup": "4.63.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-dts": "6.5.1",
    "rollup-plugin-scss": "4.0.1",
    "sass": "1.103.1",
    "ts-jest": "29.4.12",
    "tslib": "^2.8.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@ministryofjustice/frontend": "11.0.0",
    "@ministryofjustice/hmpps-rest-client": "2.2.0",
    "@types/bunyan": "^1.8.11",
    "fuse.js": "7.5.0",
    "superagent": "10.3.0"
  },
  "peerDependencies": {
    "@ministryofjustice/frontend": "10 | 11",
    "govuk-frontend": "^6"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
